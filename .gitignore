__pycache__/

# launch_demo.py runs its browser driver from a launch-demo- directory
# under the repo root and removes it after; never track a leftover.
/launch-demo-*/

# claude plugin eval run output (ADR-0081): scratch, never committed;
# a run cited as evidence is copied into plugin-evals/records/.
/plugin-evals/results/

# Retired by ADR-0083: beads is gone, but checkouts that once ran bd keep a
# local .beads/ (a ~40 MB Dolt store). Ignored so a broad `git add` can never
# commit it; delete it locally whenever you like (#786).
.beads/
